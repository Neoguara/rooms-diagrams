@startuml

skinparam linetype ortho
skinparam backgroundColor white
skinparam node {
  BorderColor #444444
  BackgroundColor #f9f9f9
  FontStyle bold
}
skinparam artifact {
  BorderColor #444444
  BackgroundColor #FFFFFF
}
skinparam folder {
  BorderColor #444444
  BackgroundColor #FFFFFF
}
skinparam database {
  BorderColor #444444
  BackgroundColor #FFF3CC
}
skinparam arrow {
  Color #555555
}

node "Cliente" <<device>> #DDEEFF {
  artifact "Navegador Web" as browser
}

node "Servidor" <<server>> #F2F2F2 {

  node "Serviço Web" <<service>> #DDFFD8 {
    artifact "Frontend (build estático React)" as Frontend
  }

  node "Serviço de Aplicação" <<service>> #FFE0D8 {
    artifact "Spring Boot" as api
  }

  node "Serviço de Banco de Dados" <<service>> #FFF3CC {
    database "PostgreSQL" as db
  }
}

browser --> Frontend : HTTPS\nbaixa a aplicação
browser --> api      : HTTPS\nREST + JSON

api --> db      : JDBC

@enduml
