@startuml
left to right direction

skinparam linetype ortho

actor sa_professor
actor sa_coordenador

sa_coordenador --|> sa_professor

rectangle "Reserva de Salas" {

    usecase "suc_gerenciar_ambientes" as UC3

    usecase "suc_gerenciar_prédios" as UC11
    usecase "suc_gerenciar_recursos" as UC12
    usecase "suc_gerenciar_salas" as UC13
    usecase "suc_gerenciar_tipos_de_salas" as UC14

    usecase "suc_gerenciar_agendamentos" as UC4
    usecase "suc_gerar_relatórios" as UC5
    usecase "suc_gerenciar_usuarios" as UC7
    usecase "suc_exportar_relatórios" as UC9
    usecase "suc_gerenciar_solicitações" as UC10
}

sa_professor --> UC10
sa_professor --> UC3
sa_professor --> UC4
sa_professor --> UC5

sa_coordenador --> UC7

UC3 <|-- UC11
UC3 <|-- UC12
UC3 <|-- UC13
UC3 <|-- UC14

UC5 <.. UC9 : <<extend>>

@enduml