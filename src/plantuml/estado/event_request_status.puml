@startuml event_request_status

title EventRequest: Ciclo de Vida do Status

skinparam state {
  BackgroundColor #EEF2FF
  BorderColor #7070AA
  ArrowColor #555588
  FontSize 13
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #CCBB55

[*] --> PENDING : EventRequest.open()

PENDING --> APPROVED : approve()
PENDING --> REJECTED : reject()

APPROVED --> [*]
REJECTED --> [*]

APPROVED -[dotted]-> PENDING : reverse()
REJECTED -[dotted]-> PENDING : reverse()

note as N1
  reverse()abre um grupo novo em PENDING.
end note

@enduml
