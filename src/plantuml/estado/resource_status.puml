@startuml resource_status

' Fonte: ResourceStatus e os métodos activate/deactivate/delete de Resource (rooms-backend).

title Resource: Ciclo de Vida do Status

!include estilo.iuml

[*] --> ACTIVE : create()

ACTIVE   --> INACTIVE : deactivate()

INACTIVE --> ACTIVE   : activate()
INACTIVE --> DELETED  : delete()

DELETED --> [*]

@enduml
