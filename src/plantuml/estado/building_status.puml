@startuml building_status

' Fonte: BuildingStatus e os métodos activate/deactivate/delete de Building (rooms-backend).

title Building: Ciclo de Vida do Status

!include estilo.iuml

[*] --> ACTIVE : Building.create()

ACTIVE   --> INACTIVE : deactivate()

INACTIVE --> ACTIVE   : activate()
INACTIVE --> DELETED  : delete()

DELETED --> [*]

@enduml
