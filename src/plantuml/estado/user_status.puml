@startuml user_status

' Fonte: UserStatus e os métodos activate/deactivate/delete de User (rooms-backend).

title User: Ciclo de Vida do Status

!include estilo.iuml

[*] --> ACTIVE : User.create()

ACTIVE   --> ACTIVE   : activate()
ACTIVE   --> INACTIVE : deactivate()

INACTIVE --> ACTIVE   : activate()
INACTIVE --> DELETED  : delete()

DELETED --> [*]

@enduml
