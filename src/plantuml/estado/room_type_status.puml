@startuml room_type_status

title RoomType: Ciclo de Vida do Status

skinparam state {
  BackgroundColor #EEF2FF
  BorderColor #7070AA
  ArrowColor #555588
  FontSize 13
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #CCBB55

[*] --> ACTIVE : create()

ACTIVE   --> INACTIVE : deactivate()
INACTIVE --> ACTIVE   : activate()
INACTIVE --> DELETED  : delete()

DELETED --> [*]

@enduml
