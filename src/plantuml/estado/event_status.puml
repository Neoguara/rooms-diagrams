@startuml event_status

' Fonte: EventStatus e os métodos cancel/discard/reactivate/complete/archive de Event
' (rooms-backend). Quem dispara as transições é ReviewEventRequestUseCase, ao aprovar um
' grupo: cada tipo de EventChangeItem vira uma chamada dessas.

title Event: Ciclo de Vida do Status

!include estilo.iuml

[*] --> ACTIVE : create()

ACTIVE    --> CANCELLED : cancel()
CANCELLED --> ACTIVE    : reactivate()

ACTIVE    --> DISCARDED : discard()
CANCELLED --> DISCARDED : discard()

ACTIVE    --> COMPLETED : complete()

CANCELLED --> ARCHIVED : archive()
COMPLETED --> ARCHIVED : archive()
DISCARDED --> ARCHIVED : archive()

ARCHIVED --> [*]

@enduml
