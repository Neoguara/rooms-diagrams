@startuml der

skinparam linetype ortho

' ── users ──────────────────────────────────────────────
entity "users" as User {
  * id : UUID <<PK>>
  --
  name : VARCHAR
  email : VARCHAR <<unique>>
  password : VARCHAR
  role : VARCHAR
  status : VARCHAR
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── buildings ──────────────────────────────────────────
entity "buildings" as Building {
  * id : UUID <<PK>>
  --
  name : VARCHAR
  address : VARCHAR
  total_floors : INTEGER
  status : VARCHAR
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── room_types ─────────────────────────────────────────
entity "room_types" as RoomType {
  * id : UUID <<PK>>
  --
  name : VARCHAR
  description : VARCHAR
  default_capacity : VARCHAR
  color : VARCHAR
  icon : VARCHAR
  status : VARCHAR
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── rooms ──────────────────────────────────────────────
entity "rooms" as Room {
  * id : UUID <<PK>>
  --
  * building_id : UUID <<FK>>
  * room_type_id : UUID <<FK>>
  name : VARCHAR
  code : VARCHAR
  floor : INTEGER
  capacity : INTEGER
  status : VARCHAR
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── resources ──────────────────────────────────────────
entity "resources" as Resource {
  * id : UUID <<PK>>
  --
  name : VARCHAR
  description : VARCHAR
  icon : VARCHAR
  status : VARCHAR
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── room_resources ─────────────────────────────────────
entity "room_resources" as RoomResource {
  * id : UUID <<PK>>
  --
  * room_id : UUID <<FK>>
  * resource_id : UUID <<FK>>
  created_at : TIMESTAMP
}

' ── events ─────────────────────────────────────────────
entity "events" as Event {
  * id : UUID <<PK>>
  --
  * room_id : UUID <<FK>>
  title : VARCHAR
  description : VARCHAR
  start_at : TIMESTAMP
  end_at : TIMESTAMP
  is_all_day : BOOLEAN
  recurrence_rule : VARCHAR
  series_id : UUID
  status : VARCHAR
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── event_requests ─────────────────────────────────────
entity "event_requests" as EventRequest {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  reversal_of : UUID <<FK>>
  status : VARCHAR
  justification : VARCHAR
  created_at : TIMESTAMP
}

' ── event_change_items ─────────────────────────────────
entity "event_change_items" as EventChangeItem {
  * id : UUID <<PK>>
  --
  * event_request_id : UUID <<FK>>
  event_id : UUID <<FK>>
  reversal_of : UUID <<FK>>
  type : VARCHAR
  item_position : INTEGER
  --
  old_room_id : UUID
  old_title : VARCHAR
  old_description : VARCHAR
  old_start_at : TIMESTAMP
  old_end_at : TIMESTAMP
  old_is_all_day : BOOLEAN
  old_recurrence_rule : VARCHAR
  old_series_id : UUID
  --
  new_room_id : UUID
  new_title : VARCHAR
  new_description : VARCHAR
  new_start_at : TIMESTAMP
  new_end_at : TIMESTAMP
  new_is_all_day : BOOLEAN
  new_recurrence_rule : VARCHAR
  new_series_id : UUID
}

' ── approvals ──────────────────────────────────────────
entity "approvals" as Approval {
  * id : UUID <<PK>>
  --
  * event_request_id : UUID <<FK>>
  * user_id : UUID <<FK>>
  decision : VARCHAR
  comment : VARCHAR
  decided_at : TIMESTAMP
}

' ── reports ────────────────────────────────────────────
entity "reports" as Report {
  * id : UUID <<PK>>
  --
  * requested_by : UUID <<FK>>
  type : VARCHAR
  format : VARCHAR
  status : VARCHAR
  --
  start_at : TIMESTAMP
  end_at : TIMESTAMP
  room_id : UUID <<FK>>
  --
  filename : VARCHAR
  content_type : VARCHAR
  size_bytes : BIGINT
  storage_key : VARCHAR
  --
  failure_reason : VARCHAR
  requested_at : TIMESTAMP
  started_at : TIMESTAMP
  finished_at : TIMESTAMP
}

' ── Relacionamentos ────────────────────────────────────
Building     "(1,1)" ||--o{ "(0,n)" Room
RoomType     "(1,1)" ||--o{ "(0,n)" Room

Room         "(1,1)" ||--o{ "(0,n)" RoomResource
Resource     "(1,1)" ||--o{ "(0,n)" RoomResource

Room         "(1,1)" ||--o{ "(0,n)" Event

User         "(1,1)" ||--o{ "(0,n)" EventRequest
EventRequest "(1,1)" ||--o{ "(1,n)" EventChangeItem
Event        "(0,1)" |o--o{ "(0,n)" EventChangeItem

EventRequest "(1,1)" ||--o{ "(0,n)" Approval
User         "(1,1)" ||--o{ "(0,n)" Approval

User         "(1,1)" ||--o{ "(0,n)" Report
Room         "(0,1)" |o--o{ "(0,n)" Report

@enduml
