@startuml user

' Módulo user: cadastro e ciclo de vida do usuário.
' Fonte: com.neoguara.rooms.user (rooms-backend).
'
' Esta versão é exaustiva: toda classe do módulo, todos os membros e toda dependência que
' existe no código. Legibilidade não é o critério aqui.

left to right direction
skinparam packageStyle rectangle

package "Domain" #EEF2FF {

  package "entities" {
    class User {
      - UserId id
      - String name
      - String email
      - String password
      - UserRole role
      - UserStatus status
      - LocalDateTime createdAt
      - LocalDateTime updatedAt
      # User()
      - User(String,String,String,UserRole)
      + {static} User create(String,String,String,UserRole)
      + void update(String,String,String,UserRole)
      + void activate()
      + void deactivate()
      + void delete()
      + UserId getId()
      + String getName()
      + String getEmail()
      + String getPassword()
      + UserRole getRole()
      + UserStatus getStatus()
      + LocalDateTime getCreatedAt()
      + LocalDateTime getUpdatedAt()
    }
  }

  package "valueobjects" {
    class UserId <<record>> {
      - UUID id
      + UserId(UUID)
      + UserId()
      + {static} UserId of(UUID)
      + UUID id()
    }
  }

  package "enums" {
    enum UserRole {
      ADMIN
      USER
    }
    enum UserStatus {
      ACTIVE
      INACTIVE
      DELETED
    }
  }

  package "validation" {
    class UserValidator {
      + void validate(User,Notification)
    }
  }
}

package "Application" #F0FFF0 {

  package "ports" {
    interface UserRepositoryPort {
      + User save(User)
      + Optional<User> findById(UserId)
      + List<User> findAll()
      + Optional<User> findByEmail(String)
      + boolean existsByEmail(String)
    }
  }

  package "mappers" {
    class UserMapper {
      - UserMapper()
      + {static} User toDomain(CreateUserRequest,String)
      + {static} UserResponse toResponse(User)
    }
  }

  package "usecases" {
    class CreateUserUseCase <<Service>> {
      - UserRepositoryPort repository
      - PasswordEncoder passwordEncoder
      + CreateUserUseCase(UserRepositoryPort,PasswordEncoder)
      + UserResponse execute(CreateUserRequest)
    }
    class GetUserUseCase <<Service>> {
      - UserRepositoryPort repository
      + GetUserUseCase(UserRepositoryPort)
      + UserResponse findById(UUID)
      + List<UserResponse> findAll()
    }
    class UpdateUserUseCase <<Service>> {
      - UserRepositoryPort repository
      - PasswordEncoder passwordEncoder
      + UpdateUserUseCase(UserRepositoryPort,PasswordEncoder)
      + UserResponse execute(UUID,UpdateUserRequest)
    }
    class UpdateUserStatusUseCase <<Service>> {
      - UserRepositoryPort repository
      + UpdateUserStatusUseCase(UserRepositoryPort)
      + UserResponse execute(UUID,UpdateUserStatusRequest.Status)
    }
    class DeleteUserUseCase <<Service>> {
      - UserRepositoryPort repository
      + DeleteUserUseCase(UserRepositoryPort)
      + void execute(UUID)
    }
  }

  package "dtos" {
    class CreateUserRequest <<record>> {
      - String name
      - String email
      - String password
      - UserRole role
    }
    class UpdateUserRequest <<record>> {
      - String name
      - String email
      - String password
      - UserRole role
    }
    class UpdateUserStatusRequest <<record>> {
      - Status status
    }
    enum "UpdateUserStatusRequest.Status" as UpdateUserStatusRequestStatus {
      ACTIVE
      INACTIVE
    }
    class UserResponse <<record>> {
      - UUID id
      - String name
      - String email
      - UserRole role
      - UserStatus status
      - LocalDateTime createdAt
      - LocalDateTime updatedAt
    }
  }
}

package "Infrastructure" #FFF8F0 {

  package "web" {
    class UserController <<RestController>> {
      - CreateUserUseCase createUserUseCase
      - GetUserUseCase getUserUseCase
      - UpdateUserUseCase updateUserUseCase
      - UpdateUserStatusUseCase updateUserStatusUseCase
      - DeleteUserUseCase deleteUserUseCase
      + UserController(CreateUserUseCase,GetUserUseCase,UpdateUserUseCase,UpdateUserStatusUseCase,DeleteUserUseCase)
      + ResponseEntity<UserResponse> create(CreateUserRequest)
      + ResponseEntity<List<UserResponse>> findAll()
      + ResponseEntity<UserResponse> findById(UUID)
      + ResponseEntity<UserResponse> update(UUID,UpdateUserRequest)
      + ResponseEntity<Void> deleteById(UUID)
      + ResponseEntity<UserResponse> updateStatus(UUID,UpdateUserStatusRequest)
    }
  }

  package "repositories" {
    class UserRepositoryImpl <<Repository>> {
      - UserJpaRepository jpaRepository
      + UserRepositoryImpl(UserJpaRepository)
      + User save(User)
      + Optional<User> findById(UserId)
      + List<User> findAll()
      + Optional<User> findByEmail(String)
      + boolean existsByEmail(String)
    }
    interface UserJpaRepository {
      + Optional<User> findByEmail(String)
      + boolean existsByEmail(String)
      + List<User> findAllByStatusNot(UserStatus)
      + Optional<User> findByIdAndStatusNot(UserId,UserStatus)
      + Optional<User> findByEmailAndStatusNot(String,UserStatus)
      + boolean existsByEmailAndStatusNot(String,UserStatus)
    }
  }

  package "auth" {
    class UserAuthAdapter <<Component>> {
      - UserRepositoryPort userRepository
      + UserAuthAdapter(UserRepositoryPort)
      + Optional<AuthUserData> findByEmail(String)
    }
  }
}

' Tipos de fora do módulo. Declarados aqui só para as setas terem onde chegar.
package "Dependências externas" #F5F5F5 {
  interface "Validator<T>" as Validator <<shared>> {
    + void validate(T,Notification)
  }
  class Notification <<shared>> {
    + {static} Notification create()
    + Notification addError(String)
    + Notification addErrorIf(boolean,String)
    + boolean hasErrors()
    + List<String> getErrors()
    + Notification merge(Notification)
    + void raiseIfHasErrors()
  }
  class ResourceNotFoundException <<shared>>
  class ConflictException <<shared>>
  class InvalidStateException <<shared>>
  interface UserAuthPort <<auth>> {
    + Optional<AuthUserData> findByEmail(String)
  }
  class AuthUserData <<auth>> <<record>>
  interface JpaRepository <<spring data>>
  interface PasswordEncoder <<spring security>>
}

' ── Herança e implementação ────────────────────────────
Validator <|.. UserValidator
UserRepositoryPort <|.. UserRepositoryImpl
UserAuthPort <|.. UserAuthAdapter
JpaRepository <|-- UserJpaRepository

' ── Campos ─────────────────────────────────────────────
UserController --> CreateUserUseCase
UserController --> GetUserUseCase
UserController --> UpdateUserUseCase
UserController --> UpdateUserStatusUseCase
UserController --> DeleteUserUseCase

CreateUserUseCase --> UserRepositoryPort
GetUserUseCase --> UserRepositoryPort
UpdateUserUseCase --> UserRepositoryPort
UpdateUserStatusUseCase --> UserRepositoryPort
DeleteUserUseCase --> UserRepositoryPort

CreateUserUseCase --> PasswordEncoder
UpdateUserUseCase --> PasswordEncoder

UserRepositoryImpl --> UserJpaRepository
UserAuthAdapter --> UserRepositoryPort

User *-- UserId
User --> UserRole
User --> UserStatus

CreateUserRequest --> UserRole
UpdateUserRequest --> UserRole
UserResponse --> UserRole
UserResponse --> UserStatus
UpdateUserStatusRequest *-- UpdateUserStatusRequestStatus

' ── Uso: controller e DTOs ─────────────────────────────
UserController ..> CreateUserRequest
UserController ..> UpdateUserRequest
UserController ..> UpdateUserStatusRequest
UserController ..> UserResponse

' ── Uso: casos de uso ──────────────────────────────────
CreateUserUseCase ..> CreateUserRequest
CreateUserUseCase ..> UserResponse
CreateUserUseCase ..> UserMapper
CreateUserUseCase ..> ConflictException
GetUserUseCase ..> UserResponse
GetUserUseCase ..> UserMapper
GetUserUseCase ..> UserId
GetUserUseCase ..> ResourceNotFoundException
UpdateUserUseCase ..> UpdateUserRequest
UpdateUserUseCase ..> UserResponse
UpdateUserUseCase ..> UserMapper
UpdateUserUseCase ..> UserId
UpdateUserUseCase ..> ResourceNotFoundException
UpdateUserStatusUseCase ..> UpdateUserStatusRequestStatus
UpdateUserStatusUseCase ..> UserResponse
UpdateUserStatusUseCase ..> UserMapper
UpdateUserStatusUseCase ..> UserId
UpdateUserStatusUseCase ..> ResourceNotFoundException
DeleteUserUseCase ..> UserId
DeleteUserUseCase ..> ResourceNotFoundException

' ── Uso: mapper ────────────────────────────────────────
UserMapper ..> User
UserMapper ..> CreateUserRequest
UserMapper ..> UserResponse

' ── Uso: domínio ───────────────────────────────────────
User ..> UserValidator
User ..> Notification
User ..> InvalidStateException
UserValidator ..> Notification

' ── Uso: infraestrutura ────────────────────────────────
UserRepositoryImpl ..> UserStatus
UserJpaRepository ..> User
UserJpaRepository ..> UserId
UserJpaRepository ..> UserStatus
UserAuthAdapter ..> AuthUserData
UserAuthAdapter ..> UserStatus

@enduml
