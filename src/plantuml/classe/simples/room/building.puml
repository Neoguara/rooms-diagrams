@startuml room_building

' Versão simples do recorte de prédio, dentro do módulo room. A versão exaustiva do módulo
' inteiro está em classe/room.puml, e é ela que serve de referência de sincronia.
'
' O que esta versão corta: DTOs, mappers, validators, exceções, getters, construtores,
' métodos privados, os tipos de fora do módulo, e as dependências de uso, exceto as que
' ligam um serviço de domínio ao que ele opera.

left to right direction
skinparam packageStyle rectangle

package "Domain" #EEF2FF {

  class Building <<Entity>> {
    - BuildingId id
    - String name
    - String address
    - Integer totalFloors
    - BuildingStatus status
    - LocalDateTime createdAt
    - LocalDateTime updatedAt
    + {static} create()
    + update()
    + activate()
    + deactivate()
    + delete()
    + isAvailable()
  }

  class BuildingId <<record>> {
    - UUID id
  }

  enum BuildingStatus {
    ACTIVE
    INACTIVE
    DELETED
  }
}

package "Application" #F0FFF0 {

  interface BuildingRepositoryPort {
    + Building save(Building)
    + Optional<Building> findById(BuildingId)
    + List<Building> findAll()
  }

  class CreateBuildingUseCase <<Service>> {
    + execute()
  }
  class GetBuildingUseCase <<Service>> {
    + findById()
    + findAll()
  }
  class UpdateBuildingUseCase <<Service>> {
    + execute()
  }
  class UpdateBuildingStatusUseCase <<Service>> {
    + execute()
  }
  class DeleteBuildingUseCase <<Service>> {
    + execute()
  }
}

package "Infrastructure" #FFF8F0 {

  class BuildingController <<RestController>> {
    + createBuilding()
    + listBuildings()
    + getBuilding()
    + updateBuilding()
    + updateBuildingStatus()
    + deleteBuilding()
  }

  class BuildingRepositoryImpl <<Repository>>

  interface BuildingJpaRepository
}

' ── Implementação ──────────────────────────────────────
BuildingRepositoryPort <|.. BuildingRepositoryImpl

' ── Campos ─────────────────────────────────────────────
Building *-- BuildingId
Building --> BuildingStatus

BuildingController --> CreateBuildingUseCase
BuildingController --> GetBuildingUseCase
BuildingController --> UpdateBuildingUseCase
BuildingController --> UpdateBuildingStatusUseCase
BuildingController --> DeleteBuildingUseCase

CreateBuildingUseCase --> BuildingRepositoryPort
GetBuildingUseCase --> BuildingRepositoryPort
UpdateBuildingUseCase --> BuildingRepositoryPort
UpdateBuildingStatusUseCase --> BuildingRepositoryPort
DeleteBuildingUseCase --> BuildingRepositoryPort

BuildingRepositoryImpl --> BuildingJpaRepository

@enduml
