@startuml

skinparam linetype ortho
skinparam packageStyle rectangle
left to right direction

package "Domain" #EEF2FF {

  package "entities" {
    class Event {
      - EventId id
      - RoomId roomId
      - String title
      - String description
      - LocalDateTime startAt
      - LocalDateTime endAt
      - Boolean isAllDay
      - String recurrenceRule
      - SeriesId seriesId
      - EventStatus status
      - LocalDateTime createdAt
      - LocalDateTime updatedAt
      + {static} Event create(RoomId,String,String,LocalDateTime,LocalDateTime,Boolean,String,SeriesId,RoomOccupancy)
      + void update(RoomId,String,String,LocalDateTime,LocalDateTime,Boolean,String,RoomOccupancy)
      + void cancel()
      + void reactivate(RoomOccupancy)
      + void discard()
      + void complete()
      + void archive()
      - void requireFreeSlot(RoomOccupancy)
    }

    class EventRequest {
      - EventRequestId id
      - UserId createdBy
      - EventRequestStatus status
      - EventRequestId reversalOf
      - String justification
      - LocalDateTime createdAt
      + {static} EventRequest open(UserId,String)
      + void markAsReversalOf(EventRequestId)
      + void approve()
      + void reject()
      - void requirePending()
    }

    class EventChangeItem {
      - EventChangeItemId id
      - EventRequestId eventRequestId
      - EventId eventId
      - EventChangeType type
      - Integer position
      - EventChangeItemId reversalOf
      - EventSnapshot before
      - EventSnapshot after
      + {static} EventChangeItem create(EventRequestId,int,EventSnapshot)
      + {static} EventChangeItem update(EventRequestId,int,Event,EventSnapshot)
      + {static} EventChangeItem cancel(EventRequestId,int,Event)
      + {static} EventChangeItem reactivate(EventRequestId,int,Event)
      + {static} EventChangeItem discard(EventRequestId,int,Event)
      + void markAsReversalOf(EventChangeItemId)
      + void linkCreatedEvent(EventId)
      - {static} EventChangeItem validated(EventRequestId,int,EventChangeType,EventId,EventSnapshot,EventSnapshot)
      - {static} EventSnapshot snapshotOf(Event)
    }

    class Approval {
      - ApprovalId id
      - EventRequestId eventRequestId
      - UserId decidedBy
      - ApprovalDecision decision
      - String comment
      - LocalDateTime decidedAt
      + {static} Approval of(EventRequestId,UserId,ApprovalDecision,String)
    }
  }

  package "valueobjects" {
    class EventId <<record>> {
      - UUID id
      + {static} EventId of(UUID)
    }
    class EventRequestId <<record>> {
      - UUID id
      + {static} EventRequestId of(UUID)
    }
    class EventChangeItemId <<record>> {
      - UUID id
      + {static} EventChangeItemId of(UUID)
    }
    class ApprovalId <<record>> {
      - UUID id
      + {static} ApprovalId of(UUID)
    }
    class RoomId <<record>> {
      - UUID id
      + {static} RoomId of(UUID)
    }
    class UserId <<record>> {
      - UUID id
      + {static} UserId of(UUID)
    }
    class SeriesId <<record>> {
      - UUID id
      + {static} SeriesId of(UUID)
    }
    class EventSnapshot {
      - RoomId roomId
      - String title
      - String description
      - LocalDateTime startAt
      - LocalDateTime endAt
      - Boolean isAllDay
      - String recurrenceRule
      - SeriesId seriesId
      + {static} EventSnapshot of(RoomId,String,String,LocalDateTime,LocalDateTime,Boolean,String,SeriesId)
    }
    class RecurrenceRule <<record>> {
      - Frequency frequency
      - int interval
      - Set<DayOfWeek> byDay
      - Integer count
      - LocalDate until
      + {static} int MAX_OCCURRENCES
      + {static} RecurrenceRule parse(String)
      + String format()
    }
    enum Frequency {
      DAILY
      WEEKLY
      MONTHLY
    }
  }

  package "enums" {
    enum EventStatus {
      ACTIVE
      CANCELLED
      COMPLETED
      ARCHIVED
      DISCARDED
      + boolean occupiesRoom()
      + {static} Set<EventStatus> occupying()
    }
    enum EventRequestStatus {
      PENDING
      APPROVED
      REJECTED
    }
    enum EventChangeType {
      CREATE
      UPDATE
      CANCEL
      REACTIVATE
      DISCARD
    }
    enum ApprovalDecision {
      APPROVED
      REJECTED
    }
  }

  package "services" {
    interface RoomOccupancy <<FunctionalInterface>> {
      + List<Event> occupying(RoomId,LocalDateTime,LocalDateTime)
    }
    class LoadedOccupancy {
      - List<Event> events
      + {static} RoomOccupancy of(List<Event>)
      + List<Event> occupying(RoomId,LocalDateTime,LocalDateTime)
    }
    class OccupiedSlot <<record>> {
      - UUID id
      - RoomId roomId
      - String title
      - LocalDateTime startAt
      - LocalDateTime endAt
      + {static} OccupiedSlot of(Event)
      + boolean competesWith(OccupiedSlot)
    }
    class EventConflict <<record>> {
      - OccupiedSlot attempted
      - OccupiedSlot occupant
      + {static} List<EventConflict> against(OccupiedSlot,Collection<OccupiedSlot>)
      + String describe()
    }
    class EventRequestConflicts {
      + {static} List<OccupiedSlot> claims(List<EventChangeItem>)
      + {static} List<EventConflict> preview(List<EventChangeItem>,RoomOccupancy)
    }
    class OccurrenceShift <<record>> {
      - long days
      - LocalTime timeOfDay
      - Duration duration
      + {static} OccurrenceShift between(...)
      + LocalDateTime startFrom(LocalDateTime)
      + LocalDateTime endFrom(LocalDateTime)
    }
    class RecurrenceExpander {
      + {static} List<Occurrence> expand(RecurrenceRule,LocalDateTime,LocalDateTime)
    }
    class Occurrence <<record>> {
      - LocalDateTime startAt
      - LocalDateTime endAt
    }
  }

  package "validation" {
    class EventValidation {
      + void validate(Event,Notification)
    }
    class EventRequestValidation {
      + void validate(EventRequest,Notification)
    }
    class EventChangeItemValidation {
      + void validate(EventChangeItem,Notification)
      - void validateSnapshot(EventSnapshot,Notification)
    }
    class ApprovalValidation {
      + void validate(Approval,Notification)
    }
  }

  package "exceptions" {
    class EventConflictException {
      - List<EventConflict> conflicts
      + List<EventConflict> getConflicts()
    }
  }
}

package "Application" #F0FFF0 {

  package "ports" {
    interface EventRepositoryPort {
      + List<Event> findAll()
      + Optional<Event> findById(EventId)
      + Event save(Event)
      + List<UUID> findOccupiedRoomIds(LocalDateTime,LocalDateTime)
      + List<Event> findOverlapping(RoomId,LocalDateTime,LocalDateTime)
      + List<Event> findOccupyingBetween(LocalDateTime,LocalDateTime)
      + List<Event> findBySeriesId(SeriesId)
      + List<Event> findExistingBetween(LocalDateTime,LocalDateTime)
      + List<Event> findExistingBetweenByRoom(RoomId,LocalDateTime,LocalDateTime)
    }
    interface EventRequestRepositoryPort {
      + EventRequest save(EventRequest)
      + Optional<EventRequest> findById(EventRequestId)
      + List<EventRequest> findAll()
      + boolean hasReversal(EventRequestId)
    }
    interface EventChangeItemRepositoryPort {
      + EventChangeItem save(EventChangeItem)
      + List<EventChangeItem> saveAll(List<EventChangeItem>)
      + List<EventChangeItem> findByEventRequestId(EventRequestId)
      + List<EventChangeItem> findByEventRequestIdIn(Collection<EventRequestId>)
    }
    interface ApprovalRepositoryPort {
      + Approval save(Approval)
      + List<Approval> findByEventRequestId(EventRequestId)
    }
  }

  package "usecases" {
    class GetEventUseCase {
      - EventRepositoryPort repository
      + List<EventResponse> findAll()
      + List<EventResponse> findBySeries(UUID)
    }
    class GetEventRequestUseCase {
      - EventRequestRepositoryPort repository
      - EventChangeItemRepositoryPort changeItemRepository
      - EventRepositoryPort eventRepository
      + List<EventRequestResponse> findAll()
    }
    class GetEventRequestAuditUseCase {
      - EventRequestRepositoryPort repository
      - EventChangeItemRepositoryPort changeItemRepository
      - ApprovalRepositoryPort approvalRepository
      + EventRequestAuditResponse execute(UUID)
    }
    class RequestEventChangesUseCase {
      - EventRepositoryPort eventRepository
      - EventRequestRepositoryPort eventRequestRepository
      - EventChangeItemRepositoryPort changeItemRepository
      - RoomOccupancy roomOccupancy
      + EventRequestResponse execute(UUID,SubmitEventRequest)
      - List<EventChangeItem> toChangeItems(...)
      - List<EventChangeItem> createItems(...)
      - List<EventChangeItem> updateItems(...)
      - List<EventChangeItem> scopedItems(...)
      - SeriesTargets targetsOf(Event,ChangeScope,EventStatus)
    }
    class ReviewEventRequestUseCase {
      - EventRepositoryPort eventRepository
      - EventRequestRepositoryPort eventRequestRepository
      - EventChangeItemRepositoryPort changeItemRepository
      - ApprovalRepositoryPort approvalRepository
      - RoomOccupancy roomOccupancy
      + EventRequestResponse execute(UUID,UUID,ReviewEventRequest)
      - void apply(EventChangeItem)
    }
    class ReverseEventRequestUseCase {
      - EventRepositoryPort eventRepository
      - EventRequestRepositoryPort eventRequestRepository
      - EventChangeItemRepositoryPort changeItemRepository
      - RoomOccupancy roomOccupancy
      + EventRequestResponse execute(UUID,UUID,ReverseEventRequest)
      - List<EventChangeItem> inverseOf(EventRequest,List<EventChangeItem>,EventRequestId)
      - EventChangeItem undo(EventChangeItem,EventRequestId,int)
      - EventChangeItem resubmit(EventChangeItem,EventRequestId,int)
    }
  }

  package "mappers" {
    class EventMapper {
      + {static} EventResponse toResponse(Event)
    }
    class EventRequestMapper {
      + {static} EventRequestResponse toResponse(EventRequest,List<EventChangeItem>)
      + {static} EventRequestResponse toResponse(EventRequest,List<EventChangeItem>,List<EventConflict>)
      + {static} EventRequestAuditResponse toAuditResponse(...)
      - {static} EventChangeItemResponse toItemResponse(EventChangeItem)
      - {static} ApprovalResponse toApprovalResponse(Approval)
    }
  }

  package "dtos" {
    class SubmitEventRequest <<record>> {
      - String justification
      - List<EventChangeRequest> changes
    }
    interface EventChangeRequest <<sealed>>
    class CreateEventChange <<record>> {
      - String title
      - String description
      - LocalDateTime startAt
      - LocalDateTime endAt
      - Boolean isAllDay
      - String recurrenceRule
      - UUID roomId
    }
    class UpdateEventChange <<record>> {
      - UUID eventId
      - String title
      - String description
      - LocalDateTime startAt
      - LocalDateTime endAt
      - Boolean isAllDay
      - String recurrenceRule
      - UUID roomId
      - ChangeScope scope
    }
    class CancelEventChange <<record>> {
      - UUID eventId
      - ChangeScope scope
    }
    class ReactivateEventChange <<record>> {
      - UUID eventId
      - ChangeScope scope
    }
    enum ChangeScope {
      THIS_OCCURRENCE
      THIS_AND_FOLLOWING
      ALL_OCCURRENCES
    }
    class ReviewEventRequest <<record>> {
      - ApprovalDecision decision
      - String comment
    }
    class ReverseEventRequest <<record>> {
      - String justification
    }
    class EventResponse <<record>> {
      - UUID id
      - UUID roomId
      - String title
      - String description
      - LocalDateTime startAt
      - LocalDateTime endAt
      - Boolean isAllDay
      - String recurrenceRule
      - UUID seriesId
      - String status
      - LocalDateTime createdAt
      - LocalDateTime updatedAt
    }
    class EventRequestResponse <<record>> {
      - UUID id
      - UUID createdBy
      - String status
      - UUID reversalOf
      - String justification
      - LocalDateTime createdAt
      - List<EventChangeItemResponse> changes
      - List<EventConflictResponse> conflicts
    }
    class EventRequestAuditResponse <<record>> {
      - UUID id
      - UUID createdBy
      - String status
      - UUID reversalOf
      - String justification
      - LocalDateTime createdAt
      - List<EventChangeItemResponse> changes
      - List<ApprovalResponse> history
    }
    class EventChangeItemResponse <<record>> {
      - UUID id
      - String type
      - UUID eventId
      - UUID reversalOf
      - UUID oldRoomId
      - UUID newRoomId
      - String oldTitle
      - String newTitle
      - String oldDescription
      - String newDescription
      - LocalDateTime oldStartAt
      - LocalDateTime newStartAt
      - LocalDateTime oldEndAt
      - LocalDateTime newEndAt
      - Boolean oldIsAllDay
      - Boolean newIsAllDay
      - String oldRecurrenceRule
      - String newRecurrenceRule
      - UUID oldSeriesId
      - UUID newSeriesId
    }
    class ApprovalResponse <<record>> {
      - UUID id
      - UUID decidedBy
      - String decision
      - String comment
      - LocalDateTime decidedAt
    }
    class EventConflictResponse <<record>> {
      - String message
      - String attemptedTitle
      - LocalDateTime attemptedStartAt
      - LocalDateTime attemptedEndAt
      - String occupantTitle
      - LocalDateTime occupantStartAt
      - LocalDateTime occupantEndAt
      + {static} EventConflictResponse from(EventConflict)
    }
  }
}

package "Infrastructure" #FFF8F0 {

  package "web" {
    class EventController {
      - GetEventUseCase getEventUseCase
      + ResponseEntity<List<EventResponse>> listEvents(UUID)
    }
    class EventRequestController {
      - GetEventRequestUseCase getEventRequestUseCase
      - GetEventRequestAuditUseCase getEventRequestAuditUseCase
      - RequestEventChangesUseCase requestEventChangesUseCase
      - ReviewEventRequestUseCase reviewEventRequestUseCase
      - ReverseEventRequestUseCase reverseEventRequestUseCase
      + ResponseEntity<List<EventRequestResponse>> listEventRequests()
      + ResponseEntity<EventRequestResponse> requestEventChanges(AuthUserDetails,SubmitEventRequest)
      + ResponseEntity<EventRequestResponse> reviewEventRequest(AuthUserDetails,UUID,ReviewEventRequest)
      + ResponseEntity<EventRequestResponse> reverseEventRequest(AuthUserDetails,UUID,ReverseEventRequest)
      + ResponseEntity<EventRequestAuditResponse> getEventRequestAudit(UUID)
    }
  }

  package "repositories" {
    class EventRepositoryImpl {
      - EventJpaRepository jpaRepository
    }
    class EventRequestRepositoryImpl {
      - EventRequestJpaRepository repository
    }
    class EventChangeItemRepositoryImpl {
      - EventChangeItemJpaRepository jpaRepository
    }
    class ApprovalRepositoryImpl {
      - ApprovalJpaRepository jpaRepository
    }
    interface EventJpaRepository
    interface EventRequestJpaRepository
    interface EventChangeItemJpaRepository
    interface ApprovalJpaRepository
  }

  package "adapters" {
    class RoomOccupancyAdapter {
      - EventRepositoryPort eventRepository
      + List<Event> occupying(RoomId,LocalDateTime,LocalDateTime)
    }
    class EventAvailabilityAdapter {
      - EventRepositoryPort eventRepository
      + Set<UUID> findOccupiedRoomIds(LocalDateTime,LocalDateTime)
    }
    class EventReportDataAdapter {
      - EventRepositoryPort eventRepository
      + List<EventReportRow> findForReport(LocalDateTime,LocalDateTime)
      + List<EventReportRow> findForReportByRoom(UUID,LocalDateTime,LocalDateTime)
    }
  }
}

' ── Implementações de interfaces ──────────────────────────────────────────
shared.domain.validation.Validator <|.. EventValidation
shared.domain.validation.Validator <|.. EventRequestValidation
shared.domain.validation.Validator <|.. EventChangeItemValidation
shared.domain.validation.Validator <|.. ApprovalValidation

shared.domain.exceptions.ConflictException <|-- EventConflictException

RoomOccupancy <|.. LoadedOccupancy
RoomOccupancy <|.. RoomOccupancyAdapter

EventRepositoryPort <|.. EventRepositoryImpl
EventRequestRepositoryPort <|.. EventRequestRepositoryImpl
EventChangeItemRepositoryPort <|.. EventChangeItemRepositoryImpl
ApprovalRepositoryPort <|.. ApprovalRepositoryImpl

JpaRepository <|-- EventJpaRepository
JpaRepository <|-- EventRequestJpaRepository
JpaRepository <|-- EventChangeItemJpaRepository
JpaRepository <|-- ApprovalJpaRepository

room.application.ports.RoomAvailabilityPort <|.. EventAvailabilityAdapter
report.application.ports.EventReportDataPort <|.. EventReportDataAdapter

EventChangeRequest <|.. CreateEventChange
EventChangeRequest <|.. UpdateEventChange
EventChangeRequest <|.. CancelEventChange
EventChangeRequest <|.. ReactivateEventChange

' ── Entidades → Value Objects e enums ─────────────────────────────────────
Event *-- EventId
Event *-- RoomId
Event *-- SeriesId
Event --> EventStatus

EventRequest *-- EventRequestId
EventRequest --> UserId
EventRequest --> EventRequestStatus

EventChangeItem *-- EventChangeItemId
EventChangeItem --> EventRequestId
EventChangeItem --> EventId
EventChangeItem --> EventChangeType
EventChangeItem *-- EventSnapshot

Approval *-- ApprovalId
Approval --> EventRequestId
Approval --> UserId
Approval --> ApprovalDecision

EventSnapshot --> RoomId
EventSnapshot --> SeriesId
RecurrenceRule *-- Frequency

' ── Entidades → Validação ─────────────────────────────────────────────────
Event ..> EventValidation
EventRequest ..> EventRequestValidation
EventChangeItem ..> EventChangeItemValidation
Approval ..> ApprovalValidation

' ── Regra de conflito de sala ─────────────────────────────────────────────
Event ..> RoomOccupancy
Event ..> EventConflictException
EventConflict *-- OccupiedSlot
EventConflictException --> EventConflict
OccupiedSlot ..> Event
LoadedOccupancy --> Event
EventRequestConflicts ..> EventChangeItem
EventRequestConflicts ..> EventConflict
EventRequestConflicts ..> RoomOccupancy
RecurrenceExpander ..> RecurrenceRule
RecurrenceExpander *-- Occurrence

' ── Controllers → Use Cases e DTOs ────────────────────────────────────────
EventController --> GetEventUseCase
EventController ..> EventResponse

EventRequestController --> GetEventRequestUseCase
EventRequestController --> GetEventRequestAuditUseCase
EventRequestController --> RequestEventChangesUseCase
EventRequestController --> ReviewEventRequestUseCase
EventRequestController --> ReverseEventRequestUseCase
EventRequestController ..> SubmitEventRequest
EventRequestController ..> ReviewEventRequest
EventRequestController ..> ReverseEventRequest
EventRequestController ..> EventRequestResponse
EventRequestController ..> EventRequestAuditResponse

' ── Use Cases → Ports ─────────────────────────────────────────────────────
GetEventUseCase --> EventRepositoryPort

GetEventRequestUseCase --> EventRequestRepositoryPort
GetEventRequestUseCase --> EventChangeItemRepositoryPort
GetEventRequestUseCase --> EventRepositoryPort
GetEventRequestUseCase ..> EventRequestConflicts
GetEventRequestUseCase ..> LoadedOccupancy

GetEventRequestAuditUseCase --> EventRequestRepositoryPort
GetEventRequestAuditUseCase --> EventChangeItemRepositoryPort
GetEventRequestAuditUseCase --> ApprovalRepositoryPort

RequestEventChangesUseCase --> EventRepositoryPort
RequestEventChangesUseCase --> EventRequestRepositoryPort
RequestEventChangesUseCase --> EventChangeItemRepositoryPort
RequestEventChangesUseCase --> RoomOccupancy
RequestEventChangesUseCase ..> SubmitEventRequest
RequestEventChangesUseCase ..> EventChangeRequest
RequestEventChangesUseCase ..> ChangeScope
RequestEventChangesUseCase ..> EventChangeItem
RequestEventChangesUseCase ..> RecurrenceExpander
RequestEventChangesUseCase ..> OccurrenceShift

ReviewEventRequestUseCase --> EventRepositoryPort
ReviewEventRequestUseCase --> EventRequestRepositoryPort
ReviewEventRequestUseCase --> EventChangeItemRepositoryPort
ReviewEventRequestUseCase --> ApprovalRepositoryPort
ReviewEventRequestUseCase --> RoomOccupancy
ReviewEventRequestUseCase ..> ReviewEventRequest
ReviewEventRequestUseCase ..> Approval
ReviewEventRequestUseCase ..> Event

ReverseEventRequestUseCase --> EventRepositoryPort
ReverseEventRequestUseCase --> EventRequestRepositoryPort
ReverseEventRequestUseCase --> EventChangeItemRepositoryPort
ReverseEventRequestUseCase --> RoomOccupancy
ReverseEventRequestUseCase ..> ReverseEventRequest
ReverseEventRequestUseCase ..> EventRequestConflicts

' ── Use Cases → Mappers ───────────────────────────────────────────────────
GetEventUseCase ..> EventMapper
GetEventRequestUseCase ..> EventRequestMapper
GetEventRequestAuditUseCase ..> EventRequestMapper
RequestEventChangesUseCase ..> EventRequestMapper
ReviewEventRequestUseCase ..> EventRequestMapper
ReverseEventRequestUseCase ..> EventRequestMapper

' ── Mappers → Domínio e DTOs ──────────────────────────────────────────────
EventMapper ..> Event
EventMapper ..> EventResponse

EventRequestMapper ..> EventRequest
EventRequestMapper ..> EventChangeItem
EventRequestMapper ..> Approval
EventRequestMapper ..> EventRequestResponse
EventRequestMapper ..> EventRequestAuditResponse
EventRequestMapper ..> EventChangeItemResponse
EventRequestMapper ..> ApprovalResponse
EventRequestMapper ..> EventConflictResponse

EventConflictResponse ..> EventConflict

' ── Repository Impls → JPA ────────────────────────────────────────────────
EventRepositoryImpl --> EventJpaRepository
EventRequestRepositoryImpl --> EventRequestJpaRepository
EventChangeItemRepositoryImpl --> EventChangeItemJpaRepository
ApprovalRepositoryImpl --> ApprovalJpaRepository

' ── Adapters → Ports ──────────────────────────────────────────────────────
RoomOccupancyAdapter --> EventRepositoryPort
EventAvailabilityAdapter --> EventRepositoryPort
EventReportDataAdapter --> EventRepositoryPort

@enduml
