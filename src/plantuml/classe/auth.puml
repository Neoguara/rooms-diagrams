@startuml auth

' Módulo auth: login, emissão e validação de JWT, filtro de segurança.
' Fonte: com.neoguara.rooms.auth (rooms-backend).
'
' Ao contrário dos outros módulos, auth é plano: não tem domain/application/infrastructure,
' porque não tem entidade própria. Ele lê o usuário pela porta UserAuthPort, implementada
' pelo módulo user.
'
' Critério desta versão: dentro do módulo, todas as classes e todos os membros. Fora do
' módulo, aparece o que é supertipo, campo, tipo de assinatura ou exceção lançada.

left to right direction
skinparam packageStyle rectangle

package "auth" #EEF2FF {

  class AuthController <<RestController>> {
    - AuthService authService
    + AuthController(AuthService)
    + ResponseEntity<TokenResponse> login(LoginRequest,HttpServletResponse)
  }

  class AuthService <<Service>> {
    - AuthenticationManager authenticationManager
    - JwtService jwtService
    + AuthService(AuthenticationManager,JwtService)
    + TokenResponse login(LoginRequest)
  }

  class JwtService <<Service>> {
    - String secret
    - int expirationHours
    + String generateToken(String)
    + String extractUsername(String)
    + boolean isTokenValid(String)
    - Claims parseClaims(String)
    - Key signingKey()
  }

  class AuthUserDetailsService <<Service>> {
    - UserAuthPort userAuthPort
    + AuthUserDetailsService(UserAuthPort)
    + UserDetails loadUserByUsername(String)
  }

  class AuthUserDetails {
    - AuthUserData data
    + AuthUserDetails(AuthUserData)
    + AuthUserData getData()
    + UUID getId()
    + Collection<? extends GrantedAuthority> getAuthorities()
    + String getPassword()
    + String getUsername()
    + boolean isEnabled()
  }

  class SecurityFilter <<Component>> {
    - JwtService jwtService
    - UserAuthPort userAuthPort
    + SecurityFilter(JwtService,UserAuthPort)
    # void doFilterInternal(HttpServletRequest,HttpServletResponse,FilterChain)
    - String extractToken(HttpServletRequest)
  }

  class SecurityConfig <<Configuration>> {
    - SecurityFilter securityFilter
    + SecurityConfig(SecurityFilter)
    + SecurityFilterChain filterChain(HttpSecurity)
    + AuthenticationManager authenticationManager(AuthenticationConfiguration)
    + PasswordEncoder passwordEncoder()
    + CorsConfigurationSource corsConfigurationSource()
  }

  interface UserAuthPort {
    + Optional<AuthUserData> findByEmail(String)
  }

  class AuthUserData <<record>> {
    - UUID id
    - String name
    - String email
    - String encodedPassword
    - String role
    - Boolean isActive
    - LocalDateTime createdAt
    - LocalDateTime updatedAt
    - LocalDateTime deletedAt
  }

  class LoginRequest <<record>> {
    - String email
    - String password
  }

  class TokenResponse <<record>> {
    - String token
    - UUID id
    - String name
    - String email
    - String role
    - Boolean isActive
    - LocalDateTime createdAt
    - LocalDateTime updatedAt
    - LocalDateTime deletedAt
  }
}

' Tipos de fora do módulo. Declarados aqui só para as setas terem onde chegar.
package "Dependências externas" #F5F5F5 {
  class UserAuthAdapter <<user>> {
    + Optional<AuthUserData> findByEmail(String)
  }
  interface UserDetails <<spring security>>
  interface UserDetailsService <<spring security>>
  interface AuthenticationManager <<spring security>>
  interface GrantedAuthority <<spring security>>
  interface PasswordEncoder <<spring security>>
  interface SecurityFilterChain <<spring security>>
  class HttpSecurity <<spring security>>
  class AuthenticationConfiguration <<spring security>>
  class UsernameNotFoundException <<spring security>>
  interface CorsConfigurationSource <<spring web>>
  class OncePerRequestFilter <<spring web>>
  interface HttpServletRequest <<jakarta servlet>>
  interface HttpServletResponse <<jakarta servlet>>
  interface FilterChain <<jakarta servlet>>
  interface Claims <<jjwt>>
  interface Key <<java security>>
}

' ── Herança e implementação ────────────────────────────
UserDetailsService <|.. AuthUserDetailsService
UserDetails <|.. AuthUserDetails
OncePerRequestFilter <|-- SecurityFilter
UserAuthPort <|.. UserAuthAdapter

' ── Campos ─────────────────────────────────────────────
AuthController --> AuthService
AuthService --> AuthenticationManager
AuthService --> JwtService
AuthUserDetailsService --> UserAuthPort
AuthUserDetails *-- AuthUserData
SecurityFilter --> JwtService
SecurityFilter --> UserAuthPort
SecurityConfig --> SecurityFilter

' ── Uso ────────────────────────────────────────────────
AuthController ..> LoginRequest
AuthController ..> TokenResponse
AuthController ..> HttpServletResponse

AuthService ..> LoginRequest
AuthService ..> TokenResponse
AuthService ..> AuthUserDetails
AuthService ..> AuthUserData

JwtService ..> Claims
JwtService ..> Key

AuthUserDetailsService ..> AuthUserDetails
AuthUserDetailsService ..> UserDetails
AuthUserDetailsService ..> UsernameNotFoundException

AuthUserDetails ..> GrantedAuthority

UserAuthPort ..> AuthUserData

SecurityFilter ..> HttpServletRequest
SecurityFilter ..> HttpServletResponse
SecurityFilter ..> FilterChain
SecurityFilter ..> AuthUserDetails
SecurityFilter ..> AuthUserData

SecurityConfig ..> SecurityFilterChain
SecurityConfig ..> HttpSecurity
SecurityConfig ..> AuthenticationConfiguration
SecurityConfig ..> AuthenticationManager
SecurityConfig ..> PasswordEncoder
SecurityConfig ..> CorsConfigurationSource

@enduml
