' Corpo compartilhado do DER. Incluído por der.puml (vertical) e der-horizontal.puml
' (paisagem, para os slides). As duas versões diferem só na direção do layout, então
' entidades e relacionamentos vivem aqui e nunca saem de sincronia entre si.
'
' Fonte de verdade: entidades JPA de com.neoguara.rooms (rooms-backend) e o schema que o
' Hibernate gera com ddl-auto=update no H2.

skinparam linetype ortho

' ── users ──────────────────────────────────────────────
entity "users" as User {
  * id : UUID <<PK>>
  --
  * name : VARCHAR(255)
  * email : VARCHAR(255) <<unique>>
  * password : VARCHAR(255)
  * role : ENUM <<UserRole>>
  * status : ENUM <<UserStatus>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── buildings ──────────────────────────────────────────
entity "buildings" as Building {
  * id : UUID <<PK>>
  --
  name : VARCHAR(255)
  address : VARCHAR(255)
  total_floors : INTEGER
  status : ENUM <<BuildingStatus>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── room_types ─────────────────────────────────────────
entity "room_types" as RoomType {
  * id : UUID <<PK>>
  --
  name : VARCHAR(255)
  description : VARCHAR(255)
  default_capacity : VARCHAR(255)
  color : VARCHAR(255)
  icon : VARCHAR(255)
  status : ENUM <<RoomTypeStatus>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── rooms ──────────────────────────────────────────────
entity "rooms" as Room {
  * id : UUID <<PK>>
  --
  * building_id : UUID <<FK>>
  * room_type_id : UUID <<FK>>
  name : VARCHAR(255)
  code : VARCHAR(255)
  floor : INTEGER
  capacity : INTEGER
  status : ENUM <<RoomStatus>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── resources ──────────────────────────────────────────
entity "resources" as Resource {
  * id : UUID <<PK>>
  --
  name : VARCHAR(255)
  description : VARCHAR(255)
  icon : VARCHAR(255)
  status : ENUM <<ResourceStatus>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── room_resources ─────────────────────────────────────
entity "room_resources" as RoomResource {
  * id : UUID <<PK>>
  --
  * room_id : UUID <<FK>>
  * resource_id : UUID <<FK>>
  created_at : TIMESTAMP
}

' ── events ─────────────────────────────────────────────
entity "events" as Event {
  * id : UUID <<PK>>
  --
  * room_id : UUID <<FK>>
  title : VARCHAR(255)
  description : VARCHAR(255)
  start_at : TIMESTAMP
  end_at : TIMESTAMP
  is_all_day : BOOLEAN
  recurrence_rule : VARCHAR(255)
  series_id : UUID
  status : ENUM <<EventStatus>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── event_requests ─────────────────────────────────────
entity "event_requests" as EventRequest {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  reversal_of : UUID <<FK>>
  status : ENUM <<EventRequestStatus>>
  justification : VARCHAR(255)
  created_at : TIMESTAMP
}

' ── event_change_items ─────────────────────────────────
entity "event_change_items" as EventChangeItem {
  * id : UUID <<PK>>
  --
  * event_request_id : UUID <<FK>>
  event_id : UUID <<FK>>
  reversal_of : UUID <<FK>>
  type : ENUM <<EventChangeType>>
  item_position : INTEGER
  .. estado anterior ..
  old_room_id : UUID
  old_title : VARCHAR(255)
  old_description : VARCHAR(255)
  old_start_at : TIMESTAMP
  old_end_at : TIMESTAMP
  old_is_all_day : BOOLEAN
  old_recurrence_rule : VARCHAR(255)
  old_series_id : UUID
  .. estado pretendido ..
  new_room_id : UUID
  new_title : VARCHAR(255)
  new_description : VARCHAR(255)
  new_start_at : TIMESTAMP
  new_end_at : TIMESTAMP
  new_is_all_day : BOOLEAN
  new_recurrence_rule : VARCHAR(255)
  new_series_id : UUID
}

' ── approvals ──────────────────────────────────────────
entity "approvals" as Approval {
  * id : UUID <<PK>>
  --
  * event_request_id : UUID <<FK>>
  * user_id : UUID <<FK>>
  decision : ENUM <<ApprovalDecision>>
  comment : VARCHAR(255)
  decided_at : TIMESTAMP
}

' ── periods ────────────────────────────────────────────
' Catálogo puro do módulo event: não referencia evento nem sala, não reserva
' horário e não passa por EventRequest. Por isso não tem nenhum relacionamento
' no diagrama, e dois períodos podem se sobrepor sem conflito.
' start_time e end_time são TIME, não TIMESTAMP: guardam hora do dia, não
' instante, de modo que o mesmo período vale para qualquer data.
entity "periods" as Period {
  * id : UUID <<PK>>
  --
  name : VARCHAR(255)
  description : VARCHAR(255)
  start_time : TIME
  end_time : TIME
  color : VARCHAR(255)
  status : ENUM <<PeriodStatus>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ── reports ────────────────────────────────────────────
entity "reports" as Report {
  * id : UUID <<PK>>
  --
  * requested_by : UUID <<FK>>
  type : ENUM <<ReportType>>
  format : ENUM <<ReportFormat>>
  status : ENUM <<ReportStatus>>
  .. recorte apurado ..
  start_at : TIMESTAMP
  end_at : TIMESTAMP
  room_id : UUID <<FK>>
  .. arquivo gerado ..
  filename : VARCHAR(255)
  content_type : VARCHAR(255)
  size_bytes : BIGINT
  storage_key : VARCHAR(255)
  .. execução ..
  failure_reason : VARCHAR(500)
  requested_at : TIMESTAMP
  started_at : TIMESTAMP
  finished_at : TIMESTAMP
}

' ── Relacionamentos ────────────────────────────────────
Building     "(1,1)" ||--o{ "(0,n)" Room
RoomType     "(1,1)" ||--o{ "(0,n)" Room

Room         "(1,1)" ||--o{ "(0,n)" RoomResource
Resource     "(1,1)" ||--o{ "(0,n)" RoomResource

Room         "(1,1)" ||--o{ "(0,n)" Event

User         "(1,1)" ||--o{ "(0,n)" EventRequest
EventRequest "(1,1)" ||--|{ "(1,n)" EventChangeItem
Event        "(0,1)" |o--o{ "(0,n)" EventChangeItem

EventRequest "(1,1)" ||--o| "(0,1)" Approval
User         "(1,1)" ||--o{ "(0,n)" Approval

User         "(1,1)" ||--o{ "(0,n)" Report
Room         "(0,1)" |o--o{ "(0,n)" Report
