@startuml jwt_filter

' Fonte: SecurityFilter.doFilterInternal e SecurityFilter.extractToken (rooms-backend).
' O filtro nunca interrompe a cadeia: em qualquer caminho ele chama filterChain.doFilter.
' Quem recusa a requisição sem autenticação é o Spring Security, mais adiante.

title Requisição Autenticada: Validação do JWT (SecurityFilter)

actor User
boundary "Frontend" as FE
participant "SecurityFilter\n(OncePerRequestFilter)" as Filter
participant "JwtService" as Jwt
participant "UserAuthPort\n(UserAuthAdapter)" as AuthPort
participant "UserRepositoryPort" as UserRepo
participant "SecurityContextHolder" as SecCtx
participant "FilterChain" as Chain
database "users" as DB

User -> FE: realiza requisição autenticada
activate FE
FE -> Filter: HTTP Request\nAuthorization: Bearer <token>\nou Cookie: token=<token>
activate Filter

Filter -> Filter: extractToken(request)\nheader Authorization "Bearer ",\nsenão cookie `token`, senão null

alt token presente
  Filter -> Jwt: isTokenValid(token)
  activate Jwt
  Jwt -> Jwt: parseClaims(token)\nqualquer exceção vira false
  Jwt --> Filter: boolean
  deactivate Jwt

  alt token válido
    Filter -> Jwt: extractUsername(token)
    activate Jwt
    Jwt --> Filter: email
    deactivate Jwt

    Filter -> AuthPort: findByEmail(email)
    activate AuthPort
    AuthPort -> UserRepo: findByEmail(email)
    activate UserRepo
    UserRepo -> DB: SELECT * FROM users\nWHERE email=? AND status<>'DELETED'
    DB --> UserRepo: Optional<User>
    UserRepo --> AuthPort: Optional<User>
    deactivate UserRepo
    AuthPort --> Filter: Optional<AuthUserData>
    deactivate AuthPort

    alt usuário encontrado e contexto ainda sem autenticação
      Filter -> SecCtx: getContext().setAuthentication(\nUsernamePasswordAuthenticationToken(\nAuthUserDetails, null, ROLE_<role>))
      activate SecCtx
      SecCtx --> Filter:
      deactivate SecCtx
    else usuário não encontrado, ou contexto já autenticado
      Filter -> Filter: segue sem tocar no SecurityContext
    end
  else token inválido ou expirado
    Filter -> Filter: segue sem tocar no SecurityContext
  end
else sem token no header nem no cookie
  Filter -> Filter: segue sem tocar no SecurityContext
end

Filter -> Chain: doFilter(request, response)
deactivate Filter
activate Chain

alt requisição autenticada, ou rota pública
  Chain --> FE: resposta do endpoint
  FE --> User: exibe resposta
else rota protegida sem autenticação
  Chain --> FE: requisição recusada pelo Spring Security
  deactivate Chain
  FE --> User: exibe erro de autenticação
end
deactivate FE

@enduml
