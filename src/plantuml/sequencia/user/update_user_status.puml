@startuml update_user_status

' Participantes conforme classe/simples/user.puml: sem mapper e sem a interface JPA.
' O corpo só aceita ACTIVE e INACTIVE. Para chegar a DELETED existe o DELETE /users/{id},
' que exige o usuário já INACTIVE.

title PATCH /users/{id}/status: Alterar Status do Usuário

actor "Administrador" as Ator
boundary "Frontend" as FE
participant "UserController" as Ctrl
participant "UpdateUserStatusUseCase" as UC
participant "User" as Entity
participant "UserRepositoryPort" as Port
participant "UserRepositoryImpl" as Impl
database "users" as DB

Ator -> FE: ativa ou desativa o usuário
activate FE
FE -> Ctrl: PATCH /users/{id}/status\n{status: ACTIVE | INACTIVE}
activate Ctrl

Ctrl -> UC: execute(id, request.status())
activate UC

UC -> Port: findById(UserId.of(id))
activate Port
Port -> Impl: findById(userId)
activate Impl
Impl -> DB: SELECT * FROM users\nWHERE id=? AND status<>'DELETED'
DB --> Impl: Optional<User>
Impl --> Port: Optional<User>
deactivate Impl
Port --> UC: Optional<User>
deactivate Port

alt usuário não encontrado
  UC --> Ctrl: ResourceNotFoundException
  Ctrl --> FE: 404 Not Found\nNOT_FOUND
  FE --> Ator: exibe erro
else usuário encontrado

  alt status = ACTIVE
    UC -> Entity: activate()
    activate Entity
    Entity --> UC: status = ACTIVE
    deactivate Entity
  else status = INACTIVE
    UC -> Entity: deactivate()
    activate Entity
    Entity --> UC: status = INACTIVE
    deactivate Entity
  end

  UC -> Port: save(user)
  activate Port
  Port -> Impl: save(user)
  activate Impl
  Impl -> DB: UPDATE users SET status=?
  DB --> Impl: User
  Impl --> Port: User
  deactivate Impl
  Port --> UC: User
  deactivate Port

  UC --> Ctrl: UserResponse
  Ctrl --> FE: 200 OK {UserResponse}
  FE --> Ator: exibe o novo status
end

deactivate UC
deactivate Ctrl
deactivate FE

@enduml
