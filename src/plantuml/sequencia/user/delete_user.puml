@startuml delete_user

' Participantes conforme classe/simples/user.puml: sem mapper e sem a interface JPA.
' A remoção é lógica: o registro continua na tabela com status DELETED, e é isso que faz
' o email dele deixar de bloquear um cadastro novo, já que o existsByEmail filtra DELETED.

title DELETE /users/{id}: Remover Usuário

actor "Administrador" as Ator
boundary "Frontend" as FE
participant "UserController" as Ctrl
participant "DeleteUserUseCase" as UC
participant "User" as Entity
participant "UserRepositoryPort" as Port
participant "UserRepositoryImpl" as Impl
database "users" as DB

Ator -> FE: confirma a remoção
activate FE
FE -> Ctrl: DELETE /users/{id}
activate Ctrl

Ctrl -> UC: execute(id)
activate UC

UC -> Port: findById(UserId.of(id))
activate Port
Port -> Impl: findById(userId)
activate Impl
Impl -> DB: SELECT * FROM users\nWHERE id=? AND status<>'DELETED'
DB --> Impl: Optional<User>
Impl --> Port: Optional<User>
deactivate Impl
Port --> UC: Optional<User>
deactivate Port

alt usuário não encontrado
  UC --> Ctrl: ResourceNotFoundException
  Ctrl --> FE: 404 Not Found\nNOT_FOUND
  FE --> Ator: exibe erro
else usuário encontrado

  UC -> Entity: delete()
  activate Entity

  alt usuário não está INACTIVE
    Entity --> UC: InvalidStateException\n"User must be inactive before deletion"
    UC --> Ctrl: InvalidStateException
    Ctrl --> FE: 422 Unprocessable Entity\nINVALID_STATE
    FE --> Ator: pede que desative antes
  else usuário INACTIVE
    Entity --> UC: status = DELETED
    deactivate Entity

    UC -> Port: save(user)
    activate Port
    Port -> Impl: save(user)
    activate Impl
    Impl -> DB: UPDATE users SET status='DELETED'
    DB --> Impl: User
    Impl --> Port: User
    deactivate Impl
    Port --> UC: User
    deactivate Port

    UC --> Ctrl: void
    Ctrl --> FE: 204 No Content
    FE --> Ator: exibe confirmação
  end
end

deactivate UC
deactivate Ctrl
deactivate FE

@enduml
