@startuml update_user

' Participantes conforme classe/simples/user.puml: sem mapper e sem a interface JPA.
' O PasswordEncoder fica, apesar de ser tipo de fora do módulo: é ele que decide se a
' senha muda ou é mantida, e omitir a chamada esconderia essa decisão.

title PUT /users/{id}: Atualizar Usuário

actor "Administrador" as Ator
boundary "Frontend" as FE
participant "UserController" as Ctrl
participant "UpdateUserUseCase" as UC
participant "PasswordEncoder" as Encoder
participant "User" as Entity
participant "UserRepositoryPort" as Port
participant "UserRepositoryImpl" as Impl
database "users" as DB

Ator -> FE: edita os dados e confirma
activate FE
FE -> Ctrl: PUT /users/{id}\n{name, email, password?, role?}
activate Ctrl

alt corpo inválido: @Valid falha
  Ctrl --> FE: 400 Bad Request\nVALIDATION_ERROR
  FE --> Ator: exibe erros de preenchimento
else corpo válido

  Ctrl -> UC: execute(id, UpdateUserRequest)
  activate UC

  UC -> Port: findById(UserId.of(id))
  activate Port
  Port -> Impl: findById(userId)
  activate Impl
  Impl -> DB: SELECT * FROM users\nWHERE id=? AND status<>'DELETED'
  DB --> Impl: Optional<User>
  Impl --> Port: Optional<User>
  deactivate Impl
  Port --> UC: Optional<User>
  deactivate Port

  alt usuário não encontrado
    UC --> Ctrl: ResourceNotFoundException
    Ctrl --> FE: 404 Not Found\nNOT_FOUND
    FE --> Ator: exibe erro
  else usuário encontrado

    alt password informada e não em branco
      UC -> Encoder: encode(password)
      activate Encoder
      Encoder --> UC: encodedPassword
      deactivate Encoder
    else password omitida
      UC -> UC: mantém user.getPassword()
    end

    UC -> UC: role omitida mantém user.getRole()

    UC -> Entity: update(name, email, senha, papel)
    activate Entity
    Entity -> Entity: updatedAt = now()

    alt algum campo obrigatório em branco
      Entity --> UC: DomainValidationException
      UC --> Ctrl: DomainValidationException
      Ctrl --> FE: 422 Unprocessable Entity\nDOMAIN_VALIDATION_ERROR
      FE --> Ator: exibe erros de domínio
    else campos válidos
      Entity --> UC: User
      deactivate Entity

      UC -> Port: save(user)
      activate Port
      Port -> Impl: save(user)
      activate Impl
      Impl -> DB: UPDATE users SET\nname=?, email=?, password=?, role=?, updated_at=?
      DB --> Impl: User
      Impl --> Port: User
      deactivate Impl
      Port --> UC: User
      deactivate Port

      UC --> Ctrl: UserResponse
      Ctrl --> FE: 200 OK {UserResponse}
      FE --> Ator: exibe os dados atualizados
    end
  end
end
deactivate UC
deactivate Ctrl
deactivate FE

@enduml
