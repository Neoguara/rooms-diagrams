@InProceedings{Gibson2007,
  author    = {Gibson, Becky},
  booktitle = {Proceedings of the 2007 International Cross-Disciplinary Conference on Web Accessibility (W4A)},
  title     = {Enabling an Accessible Web 2.0},
  year      = {2007},
  address   = {New York, NY, USA},
  pages     = {1–6},
  publisher = {Association for Computing Machinery},
  series    = {W4A '07},
  abstract  = {The next generation of the Web is relying on new technologies to build rich interfaces and applications which enable community, collaboration, social networking and enhanced interactions. This has implication for people with disabilities who have come to rely on the Web to provide more independence, work opportunities, and social interactions. New specifications such as Accessible Rich Internet Applications (ARIA) are being developed which provide more semantic information about Web components and can enable enhanced accessibility. In addition, toolkits and testing tools are making it easier to reach the nirvana of accessibility by default in Web 2.0 projects.},
  doi       = {10.1145/1243441.1243442},
  isbn      = {1595935908},
  keywords  = {DHTML, Web 2.0, ARIA, JavaScript, HTML, accessibility},
  location  = {Banff, Canada},
  numpages  = {6},
  url       = {https://doi.org/10.1145/1243441.1243442},
}

@Manual{ReactTeam2025,
  author       = {{Meta Open Source}},
  title        = {React: The Library for Web and Native User Interfaces},
  year         = {2025},
  address      = {Menlo Park, CA, USA},
  note         = {Version 19.2.3},
  abstract     = {React 19.2 introduces the Activity component for pre-rendering hidden
                  parts of the interface, the useEffectEvent hook for separating events
                  from effects, cacheSignal for use with Server Components, and support
                  for Partial Pre-rendering. The release also includes improvements to
                  server-side rendering with Web Streams support for Node and batching
                  of Suspense boundaries.},
  keywords     = {JavaScript, user interface, component, front-end, hooks,
                  server components, concurrent rendering},
  organization = {Meta Open Source},
  url          = {https://react.dev},
}

@Manual{PostgreSQLGlobalDevelopmentGroup2025,
  author       = {{PostgreSQL Global Development Group}},
  title        = {PostgreSQL: The World's Most Advanced Open Source Relational Database},
  year         = {2025},
  address      = {Berkeley, CA, USA},
  note         = {Version 18.0},
  abstract     = {PostgreSQL 18 introduces an asynchronous I/O subsystem delivering
                  up to 3x performance improvements for read-heavy workloads, native
                  uuidv7() support for timestamp-ordered UUIDs, virtual generated
                  columns, OAuth 2.0 authentication, skip scan for multicolumn B-tree
                  indexes, and temporal constraints for PRIMARY KEY, UNIQUE, and
                  FOREIGN KEY. This release also introduces protocol version 3.2,
                  the first new wire protocol since PostgreSQL 7.4.},
  keywords     = {relational database, SQL, open source, ACID, indexing,
                  asynchronous I/O, PostgreSQL},
  organization = {PostgreSQL Global Development Group},
  url          = {https://www.postgresql.org},
}

@Manual{Oracle2025,
  author       = {{Oracle Corporation}},
  title        = {Java SE Development Kit 25: Long-Term Support Release},
  year         = {2025},
  address      = {Austin, TX, USA},
  note         = {Version 25 (LTS)},
  abstract     = {JDK 25 is the first Long-Term Support release since JDK 21, made
                  generally available on September 16, 2025. It finalizes 18 JEPs
                  including Scoped Values, Key Derivation Function API, Module Import
                  Declarations, Compact Source Files and Instance Main Methods,
                  Flexible Constructor Bodies, Compact Object Headers, and
                  Generational Shenandoah. Nine of the included JEPs focus on
                  performance and runtime improvements under Project Leyden.},
  keywords     = {Java, JDK, JVM, LTS, programming language, object-oriented,
                  JEP, virtual threads, performance},
  organization = {Oracle Corporation},
  url          = {https://openjdk.org/projects/jdk/25/},
}

@TechReport{Guo2025,
  author      = {Guo, Shu-yu and Ficarra, Michael and Gibbons, Kevin},
  title       = {ECMAScript 2025 Language Specification},
  year        = {2025},
  address     = {Geneva, Switzerland},
  institution = {Ecma International},
  number      = {ECMA-262},
  type        = {Standard},
  abstract    = {The 16th edition of the ECMAScript Language Specification introduces
                 Iterator helpers with functional operators (map, filter, take, drop),
                 new Set methods (intersection, difference, symmetricDifference,
                 isSubsetOf, isSupersetOf, isDisjointFrom), import attributes and
                 JSON module imports, Promise.try, RegExp.escape, pattern modifiers
                 for regular expressions, duplicate named capture groups, and
                 Float16Array for typed arrays. The specification was approved by the
                 129th Ecma General Assembly on June 25, 2025.},
  keywords    = {JavaScript, ECMAScript, programming language, web, TC39,
                 iterators, modules, promises, regular expressions},
  url         = {https://tc39.es/ecma262/2025/},
}

@Manual{Webb2025,
  author       = {Webb, Phil and Wilkinson, Andy and {VMware Tanzu}},
  title        = {Spring Boot: Production-Grade Spring-Based Applications},
  year         = {2025},
  address      = {Palo Alto, CA, USA},
  note         = {Version 4.0.0},
  abstract     = {Spring Boot 4.0 introduces a complete modularization of the codebase
                  providing smaller and more focused jars, first-class support for Java 25
                  while retaining Java 17 compatibility, portfolio-wide null safety
                  improvements with JSpecify, and built-in support for API Versioning
                  and HTTP Service Clients for REST-based applications. Built on top of
                  Spring Framework 7, this release adopts Jakarta EE 11, enhances
                  GraalVM native image support with AOT Repositories, and improves
                  observability for cloud-native deployments. Virtual Threads support
                  via Project Loom is also enhanced for high-throughput applications.},
  keywords     = {Java, Spring Framework, microservices, REST, cloud-native,
                  autoconfiguration, dependency injection, Jakarta EE, GraalVM,
                  virtual threads},
  organization = {VMware Tanzu},
  url          = {https://spring.io/projects/spring-boot},
}